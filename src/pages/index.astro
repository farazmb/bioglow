---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#10091c" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>

  <body>
    <div class="ambient ambient-one"></div>
    <div class="ambient ambient-two"></div>

    <header class="topbar">
      <a class="brand" href="#" aria-label="BioGlow home">
        <span class="brand-icon">✳</span>
        <span>bio<span class="brand-accent">glow</span><span class="brand-dot">.</span></span>
      </a>
      <nav class="nav-links" aria-label="Main navigation">
        <a href="#fonts">Fonts</a>
        <a href="#bio-generator">Bio Generator</a>
        <a href="#usernames">Usernames</a>
        <a href="#symbols">Symbols</a>
      </nav>
      <a class="nav-cta" href="#fonts">Explore tools <span>↗</span></a>
    </header>

    <main>
      <section class="hero">
        <div class="hero-copy">
          <div class="eyebrow"><span class="pulse-dot"></span> YOUR PROFILE, REIMAGINED</div>
          <h1>Make your text<br />feel <span class="gradient-text">like you.</span></h1>
          <p class="hero-description">Stylish fonts, aesthetic bios, unique usernames and tiny details that make your social profile unforgettable.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#fonts">Explore stylish fonts <span>↗</span></a>
            <a class="button button-secondary" href="#bio-generator">Create a bio</a>
          </div>
          <div class="hero-trust"><span class="trust-icon">✦</span> Free to use <span class="trust-separator">·</span> No signup <span class="trust-separator">·</span> Copy in one click</div>
        </div>

        <div class="hero-visual" aria-label="Stylish profile preview">
          <div class="orbit orbit-one"></div>
          <div class="orbit orbit-two"></div>
          <div class="profile-card">
            <div class="profile-cover">
              <span class="cover-star star-one">✦</span>
              <span class="cover-star star-two">✧</span>
              <span class="cover-orb"></span>
              <span class="cover-caption">YOUR LITTLE UNIVERSE</span>
            </div>
            <div class="profile-body">
              <div class="avatar">✿</div>
              <div class="profile-name">𝓎𝑜𝓊𝓇 𝓃𝒶𝓂𝑒 <span class="verified">✦</span></div>
              <div class="profile-handle">@your.own.universe</div>
              <p class="profile-bio">♡ making ordinary moments<br />feel a little magical ✧</p>
              <div class="profile-stats"><div><strong>128</strong><span>posts</span></div><div><strong>2.4k</strong><span>followers</span></div><div><strong>384</strong><span>following</span></div></div>
              <div class="profile-button">Follow ✦</div>
            </div>
          </div>
          <div class="floating-note note-top"><span>✧</span> Your vibe, your rules</div>
          <div class="floating-note note-bottom"><span>♡</span> Copy. Paste. Glow.</div>
        </div>
      </section>

      <section class="ticker" aria-label="Available tools">
        <span>✦ STYLISH FONTS</span><span>♡ AESTHETIC BIOS</span><span>✧ UNIQUE USERNAMES</span><span>☾ SYMBOL LIBRARY</span><span>✦ STYLISH FONTS</span>
      </section>

      <section class="section" id="fonts">
        <div class="section-heading">
          <div><div class="eyebrow">01 — TEXT TRANSFORMER</div><h2>Find your <span class="gradient-text">font vibe.</span></h2><p>Type anything. Turn it into something extraordinary.</p></div>
          <span class="count-pill">{fontStyles.length} styles to explore</span>
        </div>

        <div class="transformer">
          <label for="font-input">YOUR TEXT</label>
          <div class="input-wrap"><input id="font-input" type="text" maxlength="200" value="Make it aesthetic" placeholder="Type your text here..." /><span class="input-counter" id="char-count">17 / 200</span></div>
          <div class="filter-row">
            <div class="search-wrap"><span>⌕</span><input id="font-search" type="search" placeholder="Search font styles..." aria-label="Search font styles" /></div>
            <div class="filter-chips" id="font-filters">
              <button class="filter-chip active" data-filter="All">All styles</button>
              <button class="filter-chip" data-filter="Cursive">Cursive</button>
              <button class="filter-chip" data-filter="Bold">Bold</button>
              <button class="filter-chip" data-filter="Gothic">Gothic</button>
              <button class="filter-chip" data-filter="Cute">Cute</button>
              <button class="filter-chip" data-filter="Decorative">Decorative</button>
              <button class="filter-chip" data-filter="Fun">Fun</button>
            </div>
          </div>
          <div class="font-grid" id="font-grid">
            {fontStyles.map((font) => (
              <article class="font-card" data-font-card data-name={font.name.toLowerCase()} data-category={font.category}>
                <div class="font-card-top"><span>{font.name}</span><span class="font-tag">{font.category}</span></div>
                <div class="font-sample" data-font-sample data-style={font.id}>{font.sample}</div>
                <button class="copy-button" data-font-copy data-style={font.id}>Copy text <span>↗</span></button>
              </article>
            ))}
          </div>
          <p class="empty-state" id="font-empty" hidden>No styles found. Try a different search.</p>
          <div class="section-footnote"><span>✦</span> Copy your favorite style and paste it into Instagram, TikTok, Discord, or anywhere you like.</div>
        </div>
      </section>

      <section class="section split-section" id="bio-generator">
        <div class="section-heading"><div><div class="eyebrow">02 — BIO STUDIO</div><h2>A bio that feels <span class="gradient-text">like you.</span></h2><p>Pick a mood. Find your words. Make it yours.</p></div></div>
        <div class="generator-layout">
          <div class="generator-panel">
            <label for="bio-vibe">CHOOSE YOUR VIBE</label>
            <div class="vibe-grid" id="bio-vibes">
              {bioTemplates.map((bio, index) => <button class:list={["vibe-option", index === 0 && "selected"]} data-bio-vibe={bio.vibe}>{bio.vibe}</button>)}
            </div>
            <label for="bio-output">YOUR BIO</label>
            <textarea id="bio-output" rows="5" maxlength="300">{bioTemplates[0].text}</textarea>
            <div class="textarea-footer"><span id="bio-count">0 characters</span><button class="button button-primary button-small" id="bio-copy">Copy bio ↗</button></div>
            <button class="button button-secondary full-button" id="bio-regenerate">✧ Surprise me with another bio</button>
          </div>
          <div class="generator-aside">
            <div class="aside-orb">✿</div><h3>Small words.<br /><span class="gradient-text">Big personality.</span></h3><p>Your bio is your little introduction to the world. Keep it simple, make it meaningful, or decorate it with your favorite symbols.</p>
            <div class="aside-tip"><span>✦</span><div><strong>Little tip</strong><p>Use line breaks and a few symbols to make your bio easier to scan.</p></div></div>
          </div>
        </div>
      </section>

      <section class="section" id="usernames">
        <div class="section-heading"><div><div class="eyebrow">03 — USERNAME LAB</div><h2>Your next handle, <span class="gradient-text">unlocked.</span></h2><p>Find a name that fits your online identity.</p></div></div>
        <div class="username-panel">
          <label for="username-keyword">ADD A WORD (OPTIONAL)</label>
          <div class="username-controls"><input id="username-keyword" type="text" maxlength="24" placeholder="Your name, nickname, or favorite word" /><button class="button button-primary" id="generate-usernames">Generate names ✦</button></div>
          <div class="username-results" id="username-results" aria-live="polite"></div>
          <p class="small-note">Username availability isn't checked. Try your favorites on your chosen platform.</p>
        </div>
      </section>

      <section class="section" id="symbols">
        <div class="section-heading"><div><div class="eyebrow">04 — THE LITTLE DETAILS</div><h2>Symbols that <span class="gradient-text">say more.</span></h2><p>Copy a symbol, decorate your bio, or combine a few into your own signature.</p></div></div>
        <div class="symbol-panel">
          <div class="search-wrap symbol-search"><span>⌕</span><input id="symbol-search" type="search" placeholder="Search or filter symbols..." aria-label="Search symbols" /></div>
          <div class="symbol-grid" id="symbol-grid">
            {symbols.map((symbol) => <button class="symbol-button" data-symbol={symbol} aria-label={`Copy symbol ${symbol}`}>{symbol}</button>)}
          </div>
          <div class="symbol-status" id="symbol-status" aria-live="polite">Select any symbol to copy it.</div>
        </div>
      </section>

      <section class="closing-cta">
        <div class="cta-decoration cta-left">✧</div><div class="cta-decoration cta-right">♡</div>
        <div class="eyebrow">YOUR WORLD, YOUR AESTHETIC</div>
        <h2>A little more you.<br /><span class="gradient-text">A little more glow.</span></h2>
        <p>Make your words feel personal. Your next favorite style is only a click away.</p>
        <a href="#fonts" class="button button-primary">Find your style <span>↑</span></a>
      </section>
    </main>

    <footer class="footer"><a class="brand footer-brand" href="#"><span class="brand-icon">✳</span><span>bio<span class="brand-accent">glow</span><span class="brand-dot">.</span></span></a><p>Made for your little corner of the internet. ✦</p><div class="footer-links"><a href="#fonts">Fonts</a><a href="#bio-generator">Bios</a><a href="#usernames">Usernames</a><a href="#symbols">Symbols</a></div><small>© {new Date().getFullYear()} BioGlow. Free to use.</small></footer>
  </body>
</html>

